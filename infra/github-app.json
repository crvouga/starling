{
 "name":"Starling",
 "description":"Develop in isolated worktrees and review changes through pull requests.",
 "public":false,
 "default_permissions":{"contents":"write","metadata":"read","pull_requests":"write","issues":"write","checks":"read","statuses":"read"},
 "default_events":["push","pull_request","pull_request_review","pull_request_review_comment","issue_comment","check_run","check_suite","status"],
 "request_oauth_on_install":false
}
