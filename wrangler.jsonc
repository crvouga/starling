{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"starling", "main":"src/worker/index.ts", "compatibility_date":"2026-11-23",
  "compatibility_flags":["nodejs_compat"], "workers_dev":true, "preview_urls":false,
  "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*","/auth/*","/webhooks/*"]},
  "d1_databases":[{"binding":"DB","database_name":"starling","database_id":"d2d93630-b6a7-4eb3-9c3a-bd7f5743fa81"}],
  "r2_buckets":[{"binding":"PRIVATE","bucket_name":"starling-private"}],
  "durable_objects":{"bindings":[{"name":"WORKTREES","class_name":"Workspace"},{"name":"PROXIES","class_name":"ProviderProxy"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["Workspace","ProviderProxy"]}],
  "containers":[{"class_name":"Workspace","scheduling_policy":"durable_object","images":{"agent":{"dockerfile":"./container/Dockerfile","build_context":"."}}},{"class_name":"ProviderProxy","scheduling_policy":"durable_object","images":{"proxy":{"dockerfile":"./container/Proxy.Dockerfile"}}}],
  "triggers":{"crons":["*/5 * * * *"]},
  "vars":{"ORIGIN":"https://starling.crvouga.workers.dev"},
  "observability":{"enabled":true,"logs":{"invocation_logs":false}}
}
