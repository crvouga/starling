{
  "name": "starling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "npm ci",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "worker": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "e2e": "playwright test",
    "Localhost": "node scripts/localhost.mjs",
    "schema": "node scripts/schema.mjs",
    "github:register": "node scripts/register-github.mjs",
    "infra:github": "node scripts/github-infra.mjs",
    "benchmark": "node scripts/cloud-benchmark.mjs"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@heroui/react": "3.2.8",
    "@heroui/styles": "3.2.8",
    "@octokit/auth-app": "8.3.1",
    "@octokit/oauth-methods": "6.0.5",
    "@octokit/rest": "22.0.1",
    "@octokit/webhooks-methods": "6.0.0",
    "hono": "4.13.22",
    "lucide-react": "1.81.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261125.1",
